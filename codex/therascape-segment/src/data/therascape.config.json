{
  "meta": {
    "appModule": "GlucoLogic TheraScape",
    "sourceNotes": [
      "Complication-centric therapy framing: glycemia, cardiorenal disease, weight, hypoglycemia, safety, and access.",
      "When hypoglycemia risk is high, favor lower-hypoglycemia risk options in reasoning.",
      "Embedded notes are educational placeholders for UI reasoning flow and not medical advice."
    ]
  },
  "reasoningGroups": [
    {
      "groupId": "glycemia",
      "label": "Glycemia",
      "subfactors": [
        {
          "subfactorId": "a1c_gap",
          "label": "A1C gap",
          "parameterKey": "glucose_efficacy",
          "explanation": {
            "summary": [
              "The gap between current A1C and target indicates pressure to intensify therapy.",
              "Higher efficacy options may close the gap faster while balancing tradeoffs."
            ],
            "prompt": "How far is this patient from target, and what intensity is justified now?",
            "whyThisMatters": "A1C gap determines urgency and expected glucose-lowering intensity.",
            "hints": [
              "Estimate the numerical difference between current and target A1C.",
              "Compare that gap to the expected efficacy range of the current class.",
              "If the gap is large, consider whether this class likely needs support or a different class."
            ]
          }
        },
        {
          "subfactorId": "symptomatic_hyperglycemia",
          "label": "Symptomatic hyperglycemia",
          "parameterKey": "glucose_efficacy",
          "explanation": {
            "summary": [
              "Symptoms can signal near-term glycemic burden and treatment urgency.",
              "Reason through whether current efficacy is enough for symptom control."
            ],
            "prompt": "Do current symptoms suggest you need faster or stronger glucose reduction?",
            "whyThisMatters": "Symptoms can shift a plan toward agents with stronger early impact.",
            "hints": [
              "Identify whether symptoms are present in the case details.",
              "Ask if the selected class profile is high, moderate, or low efficacy.",
              "If symptomatic burden remains high, re-check your class choice rationale."
            ]
          }
        }
      ]
    },
    {
      "groupId": "cardiorenal",
      "label": "Cardiorenal Health",
      "subfactors": [
        {
          "subfactorId": "ascvd",
          "label": "ASCVD",
          "parameterKey": "ascvd_mace",
          "explanation": {
            "summary": [
              "ASCVD status guides whether cardioprotective effects should drive selection.",
              "Reason about reducing downstream event risk while controlling glucose."
            ],
            "prompt": "How much should ASCVD history weight your class selection?",
            "whyThisMatters": "ASCVD can shift priority from pure glucose lowering to event reduction.",
            "hints": [
              "Confirm if ASCVD is present in the chart.",
              "Compare class-level ASCVD/MACE impact in the profile grid.",
              "Prefer classes that align with ASCVD protection if risk is high."
            ]
          }
        },
        {
          "subfactorId": "heart_failure",
          "label": "Heart failure",
          "parameterKey": "hf_chf",
          "explanation": {
            "summary": [
              "Heart failure risk changes class tradeoffs, especially fluid and CHF effects.",
              "The chosen class should fit both glycemia and HF context."
            ],
            "prompt": "Does heart failure make your current class more or less appropriate?",
            "whyThisMatters": "HF-sensitive choices can reduce avoidable decompensation tradeoffs.",
            "hints": [
              "Check whether HF appears in case comorbidities.",
              "Review HF/CHF and fluid-volume profile columns together.",
              "Avoid choices that worsen HF-related burden when alternatives exist."
            ]
          }
        },
        {
          "subfactorId": "ckd",
          "label": "CKD",
          "parameterKey": "ckd_benefit",
          "explanation": {
            "summary": [
              "CKD stage and eGFR should shape class utility and constraints.",
              "Reason through kidney benefit and practical usability together."
            ],
            "prompt": "How does CKD status influence your therapy direction?",
            "whyThisMatters": "CKD progression and eGFR constraints can change preferred classes.",
            "hints": [
              "Identify current CKD stage and eGFR band.",
              "Check both CKD benefit and renal adjustment columns.",
              "Prioritize classes that stay usable while supporting kidney outcomes."
            ]
          }
        }
      ]
    },
    {
      "groupId": "weight",
      "label": "Weight",
      "subfactors": [
        {
          "subfactorId": "weight_bmi",
          "label": "Overweight/obesity",
          "parameterKey": "weight_effect",
          "explanation": {
            "summary": [
              "BMI burden can be a major driver when selecting among effective options.",
              "Some classes support weight goals while others may hinder them."
            ],
            "prompt": "Is weight trajectory an explicit treatment priority in this case?",
            "whyThisMatters": "Weight effect can improve adherence and metabolic outcomes over time.",
            "hints": [
              "Check BMI and related constraints in the patient profile.",
              "Compare class-level weight effect direction in the impact grid.",
              "Choose an option consistent with stated weight goals if feasible."
            ]
          }
        },
        {
          "subfactorId": "nafld_mash",
          "label": "NAFLD/MASH",
          "parameterKey": "nafld_mash",
          "explanation": {
            "summary": [
              "Liver-metabolic burden may elevate weight and insulin resistance priorities.",
              "Consider whether selected therapy aligns with metabolic liver context."
            ],
            "prompt": "How does NAFLD/MASH status influence your choice confidence?",
            "whyThisMatters": "NAFLD/MASH can influence long-horizon risk and treatment framing.",
            "hints": [
              "Verify whether NAFLD/MASH is present in this case.",
              "Cross-check weight and metabolic effect parameters together.",
              "Ensure your rationale accounts for liver-related metabolic burden."
            ]
          }
        }
      ]
    },
    {
      "groupId": "hypoglycemia",
      "label": "Hypoglycemia",
      "subfactors": [
        {
          "subfactorId": "hypoglycemia_history",
          "label": "Hypoglycemia risk profile",
          "parameterKey": "hypoglycemia_risk",
          "explanation": {
            "summary": [
              "When hypoglycemia risk is high, lower-risk classes should be favored.",
              "Balance glucose efficacy with safety around low glucose events."
            ],
            "prompt": "Does your selected class reduce hypoglycemia exposure in this patient?",
            "whyThisMatters": "Hypoglycemia can drive harm, nonadherence, and reduced quality of life.",
            "hints": [
              "Read the baseline hypoglycemia risk level first.",
              "Compare class hypoglycemia profile before finalizing.",
              "If risk is high, re-evaluate classes with higher hypo burden."
            ]
          }
        }
      ]
    },
    {
      "groupId": "access_cost",
      "label": "Access/Cost",
      "subfactors": [
        {
          "subfactorId": "access_cost",
          "label": "Affordability and access",
          "parameterKey": "access_cost",
          "explanation": {
            "summary": [
              "Access barriers can invalidate otherwise strong clinical plans.",
              "Reason through feasibility, persistence, and out-of-pocket burden."
            ],
            "prompt": "Will this plan remain realistic given the patient cost context?",
            "whyThisMatters": "A feasible therapy often outperforms an ideal but inaccessible one.",
            "hints": [
              "Check the case’s stated cost sensitivity.",
              "Match access profile against class cost burden.",
              "If barriers are high, justify mitigation or alternative class reasoning."
            ]
          }
        }
      ]
    },
    {
      "groupId": "safety",
      "label": "Safety/Tolerability",
      "subfactors": [
        {
          "subfactorId": "gi_intolerance",
          "label": "GI intolerance",
          "parameterKey": "gi_adverse",
          "explanation": {
            "summary": [
              "GI tolerability affects persistence and patient acceptance.",
              "Consider prior intolerance patterns when proposing a class."
            ],
            "prompt": "How likely is GI burden to undermine your chosen plan?",
            "whyThisMatters": "Poor tolerability can lead to early discontinuation.",
            "hints": [
              "Review prior med history for GI limitation clues.",
              "Compare GI adverse profile in the selected class.",
              "Balance efficacy gains against likely discontinuation risk."
            ]
          }
        },
        {
          "subfactorId": "infection_risk",
          "label": "Infection risk",
          "parameterKey": "infection_risk",
          "explanation": {
            "summary": [
              "Some profiles may increase concern for infection-related adverse effects.",
              "Match class risk profile with patient susceptibility signals."
            ],
            "prompt": "Does the patient’s risk profile change safety preference here?",
            "whyThisMatters": "Infection-related side effects can erode adherence and safety.",
            "hints": [
              "Identify infection susceptibility clues in history.",
              "Compare class infection-related impact scores.",
              "Favor options that reduce avoidable safety burden."
            ]
          }
        },
        {
          "subfactorId": "fluid_volume_risk",
          "label": "Fluid/volume risk",
          "parameterKey": "fluid_volume_risk",
          "explanation": {
            "summary": [
              "Volume status matters when HF/CKD and medication effects intersect.",
              "Evaluate whether class profile supports stable fluid management."
            ],
            "prompt": "Could this class create avoidable fluid/volume tradeoffs?",
            "whyThisMatters": "Volume-related issues can worsen cardiorenal stability.",
            "hints": [
              "Check fluid risk flags and HF/CKD context.",
              "Review fluid-related profile column for your class.",
              "Adjust class rationale if fluid tradeoff appears significant."
            ]
          }
        },
        {
          "subfactorId": "contraindications",
          "label": "Contraindications",
          "parameterKey": "contraindications",
          "explanation": {
            "summary": [
              "Contraindications and strong precautions can override preference.",
              "Always reconcile selected therapy with hard safety boundaries."
            ],
            "prompt": "Do any listed contraindications conflict with your current choice?",
            "whyThisMatters": "Ignoring contraindications can invalidate the plan entirely.",
            "hints": [
              "Open the full history drawer and scan contraindications.",
              "Map each concern to your selected class and drug.",
              "If conflict exists, revise class selection before final reasoning."
            ]
          }
        },
        {
          "subfactorId": "renal_adjustment",
          "label": "Renal adjustment/limitations",
          "parameterKey": "renal_adjustment",
          "explanation": {
            "summary": [
              "Renal dosing limitations can limit practical use in lower eGFR.",
              "Fit the plan to current renal function and likely trajectory."
            ],
            "prompt": "Is your selected option still practical at this eGFR?",
            "whyThisMatters": "Dosing and usability constraints affect real-world viability.",
            "hints": [
              "Check eGFR and CKD stage first.",
              "Compare renal-adjustment profile for selected class.",
              "Prioritize options with fewer renal-use limitations when needed."
            ]
          }
        }
      ]
    }
  ],
